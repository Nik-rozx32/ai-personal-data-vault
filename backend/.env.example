PORT=5000
MONGODB_URI=mongodb://localhost:27017/ai-personal-data-vault
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS and OAuth redirects)
FRONTEND_URL=http://localhost:5173

# Google OAuth 2.0
# Get from: https://console.cloud.google.com/ → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5000/api/integrations/google-drive/callback

# Google Gemini AI (for embeddings + LLM answer generation)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Token encryption key — MUST be exactly 64 hex chars (32 bytes)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_64_char_hex_string_here

# AI Chunking parameters
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
